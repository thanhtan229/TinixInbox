# Tinix Inbox Configuration
PORT=3182
HOST=127.0.0.1
NODE_ENV=development

# Chatwoot CE settings
CHATWOOT_BASE_URL=http://127.0.0.1:3180
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_CALLBACK_URL=http://callback-receiver:3181/webhooks/chatwoot

# Meta: rotate the exposed App Secret in the Meta console before setting these values.
META_APP_ID=
META_APP_SECRET=
META_SECRET_ROTATED=false
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Required for remote operator APIs; webhook tunnels must target their dedicated relay.
TINIX_OPERATOR_TOKEN=

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local fake customer/order data is disabled unless explicitly enabled.
BUSINESS_TOOLS_DEMO_MODE=false

# Optional n8n tool webhooks. Keep the bearer token in a secret store, not source control.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_AUTH_TOKEN=
